[SetUser("myuser"), SetRegState(Registered), Reply([Message { tags: None, prefix: Some(ServerName("onebotirc.villv.tech")), command: Response(RPL_WELCOME, ["nick", "欢迎来到 QQ IRC 网关 nick!myuser@onebotirc.villv.tech"]) }, Message { tags: None, prefix: Some(ServerName("onebotirc.villv.tech")), command: Response(RPL_YOURHOST, ["nick", "您的主机是 onebotirc.villv.tech，运行版本 kovi-irc-gateway-0.1"]) }, Message { tags: None, prefix: Some(ServerName("onebotirc.villv.tech")), command: Response(RPL_CREATED, ["nick", "此服务器创建于 2024-01-01T00:00:00Z"]) }, Message { tags: None, prefix: Some(ServerName("onebotirc.villv.tech")), command: Response(RPL_MYINFO, ["nick", "onebotirc.villv.tech", "kovi-irc-gateway-0.1", "io", "mnt"]) }, Message { tags: None, prefix: Some(ServerName("onebotirc.villv.tech")), command: Response(RPL_ISUPPORT, ["nick", "CASEMAPPING=ascii", "CHANTYPES=#", "CHANMODES=,,,m", "PREFIX=(o)@", "NICKLEN=30", "此服务器支持"]) }, Message { tags: None, prefix: Some(ServerName("onebotirc.villv.tech")), command: Response(RPL_MOTDSTART, ["nick", "- onebotirc.villv.tech Message of the Day -"]) }, Message { tags: None, prefix: Some(ServerName("onebotirc.villv.tech")), command: Response(RPL_MOTD, ["nick", "- 欢迎来到 QQ IRC 网关！"]) }, Message { tags: None, prefix: Some(ServerName("onebotirc.villv.tech")), command: Response(RPL_MOTD, ["nick", "- /JOIN #<群号> 加入群聊频道"]) }, Message { tags: None, prefix: Some(ServerName("onebotirc.villv.tech")), command: Response(RPL_MOTD, ["nick", "- /JOIN ##<QQ号> 私聊频道（首次发消息时自动加入）"]) }, Message { tags: None, prefix: Some(ServerName("onebotirc.villv.tech")), command: Response(RPL_ENDOFMOTD, ["nick", "/MOTD 结束"]) }])]